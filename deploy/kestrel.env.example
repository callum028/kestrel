# Kestrel secrets / environment — Pi deployment
#
# Copy this file to the real one and fill it in:
#
#   cp deploy/kestrel.env.example ~/.config/kestrel/kestrel.env
#   chmod 600 ~/.config/kestrel/kestrel.env
#
# The real file is NEVER committed to git, never copied into a backup
# destination, and never leaves the Pi except into a password manager for
# disaster recovery. Both systemd units load it via `EnvironmentFile=`
# (see deploy/systemd/*.service) — the process environment is the only place
# these values live.
#
# Sections below: "read by the code today" vs "reserved for work already
# planned in docs/design.md but not implemented yet". Keep unused variables
# commented out rather than set to empty strings, so a stray blank secret
# can't be mistaken for "configured".

# --- Read by the code today -------------------------------------------------

# Root of all durable state: kestrel.db, the session-host socket, the auth
# token file, and the memory git repo. Both units must be given the SAME
# value (server/kestrel/config.py and agent/kestrel_agent/__main__.py both
# default to ~/.kestrel if this is unset).
KESTREL_DATA=/home/callum028/.kestrel

# --- Reserved: not read by any code yet (docs/design.md §4.5, §9) ----------

# GitHub: PR/issue access for Claude Code sessions, plus the §11a webhook
# receiver (`/hooks/github`, the one endpoint ever exposed via Tailscale
# Funnel — verify its HMAC signature against this secret before trusting
# anything from it).
# GITHUB_TOKEN=
# GITHUB_WEBHOOK_SECRET=

# Notion: task/decision sync (design.md §9, "Notion and GitHub integration").
# NOTION_TOKEN=
# NOTION_DATABASE_ID=

# Microsoft 365 (calendar busy/free signal, mail) via an Azure AD app
# registration — client credentials or on-behalf-of flow, not decided yet.
# MS365_TENANT_ID=
# MS365_CLIENT_ID=
# MS365_CLIENT_SECRET=

# Auth0 — only if identity/activation (design.md §8) ends up fronted by it
# instead of being handled entirely by the Tailscale + token model in §11a.
# AUTH0_DOMAIN=
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=

# --- Read by deploy/backup.sh (not by the app itself) -----------------------

# Private git remote(s) backups are pushed to nightly. Use SSH remotes
# (git@github.com:you/kestrel-backups.git) so no token needs to sit in this
# file just to push - the Pi's own deploy key/SSH config handles auth.
# The SQLite backup and the memory repo can share one remote (different
# branches) or use two - both are supported, MEMORY_BACKUP_REMOTE falls back
# to BACKUP_REMOTE if unset.
# BACKUP_REMOTE=git@github.com:callum028/kestrel-backups.git
# MEMORY_BACKUP_REMOTE=

# --- Not a secret, but lives here for operational convenience --------------

# Port the server binds on loopback. Not currently read from the environment
# (uvicorn's --port is passed on the command line by the systemd unit) — kept
# here as documentation so the deploy scripts and the unit file agree on one
# number. If you change it, update deploy/systemd/kestrel-server.service and
# web/vite.config.ts / web/src/api.ts together.
# KESTREL_SERVER_PORT=8099
